      "-DCMAKE_BUILD_TYPE=Release",
      "-DCMAKE_POLICY_DEFAULT_CMP0091=NEW",
      "-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded",
      "-DBINARY=64",
      "-DARCH=x86_64",
      "-DTARGET=CORE2",
      "-DDYNAMIC_ARCH=ON",
