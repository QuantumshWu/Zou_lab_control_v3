  "build": {
    "target": "x86_64-windows-msvc",
    "abi": "LP64",
    "scalarPrecisions": [
      "double",
      "complex-double"
    ],
    "cpuKernels": [
      "PRESCOTT",
      "HASWELL",
      "ZEN"
    ],
    "threads": true,
    "maximumThreads": 32,
    "openmp": false,
    "staticCrt": true,
    "cmakeRuntime": "MultiThreaded",
    "openblasCmakeOptions": [
      "-DCMAKE_BUILD_TYPE=Release",
      "-DCMAKE_POLICY_DEFAULT_CMP0091=NEW",
      "-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded",
      "-DBINARY=64",
      "-DARCH=x86_64",
      "-DTARGET=CORE2",
      "-DDYNAMIC_ARCH=ON",
      "-DDYNAMIC_LIST=HASWELL;ZEN",
      "-DUSE_THREAD=ON",
      "-DUSE_OPENMP=OFF",
      "-DNUM_THREADS=32",
      "-DNO_AFFINITY=ON",
      "-DNO_WARMUP=ON",
      "-DNOFORTRAN=ON",
      "-DC_LAPACK=ON",
      "-DBUILD_TESTING=OFF",
      "-DBUILD_BENCHMARKS=OFF",
      "-DBUILD_LAPACK_DEPRECATED=OFF",
      "-DBUILD_WITHOUT_LAPACK=OFF",
      "-DBUILD_WITHOUT_LAPACKE=ON",
      "-DBUILD_SINGLE=OFF",
      "-DBUILD_COMPLEX=OFF",
      "-DBUILD_DOUBLE=ON",
      "-DBUILD_COMPLEX16=ON",
      "-DBUILD_SHARED_LIBS=OFF",
      "-DBUILD_STATIC_LIBS=ON",
      "-DMSVC_STATIC_CRT=ON"
    ]
  },
  "localFiles": [
