      "-DUSE_OPENMP=OFF",
      "-DNUM_THREADS=32",
      "-DNO_AFFINITY=ON",
      "-DNO_WARMUP=ON",
      "-DNOFORTRAN=ON",
      "-DC_LAPACK=ON",
      "-DBUILD_TESTING=OFF",
      "-DBUILD_BENCHMARKS=OFF",
      "-DBUILD_LAPACK_DEPRECATED=OFF",
      "-DBUILD_WITHOUT_LAPACK=OFF",
      "-DBUILD_WITHOUT_LAPACKE=ON",
      "-DBUILD_SINGLE=OFF",
      "-DBUILD_COMPLEX=OFF",
      "-DBUILD_DOUBLE=ON",
      "-DBUILD_COMPLEX16=ON",
      "-DBUILD_SHARED_LIBS=OFF",
      "-DBUILD_STATIC_LIBS=ON",
      "-DMSVC_STATIC_CRT=ON"
    ],
    "superluCFlags": [
      "-O2",
      "-std=c11",
      "-fno-strict-aliasing",
      "-DUSE_VENDOR_BLAS",
      "-D_CRT_SECURE_NO_WARNINGS",
      "-DAdd_",
      "-Wno-everything"
    ]
